# Postgres connection string. Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://bittada:bittada@localhost:5433/bittada?schema=public"

# Where uploaded files are stored on disk (relative to project root or absolute).
UPLOADS_DIR="./uploads"

# Optional secret used to sign session cookies (any long random string).
SESSION_COOKIE_NAME="bittada_session"

# Bootstrap super-admin credentials — read by the seed script. Change before deploying.
SUPER_ADMIN_EMAIL="admin@bittada.uz"
SUPER_ADMIN_PASSWORD="changeme123"
SUPER_ADMIN_NAME="Super Admin"

# Telegram Mini App bot token from @BotFather. Required for /tg login + bot.
TELEGRAM_BOT_TOKEN=""
# Public bot username (without @) — used by the Mini App UI for share links.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
# Public HTTPS URL of the Mini App (used by bot launch buttons). e.g. https://yourdomain/tg
TELEGRAM_WEBAPP_URL=""
# Secret token verified on the webhook (set when registering the webhook). Any random string.
TELEGRAM_WEBHOOK_SECRET=""
# Secret guarding the deadline-reminder cron endpoint. Any random string.
CRON_SECRET=""
